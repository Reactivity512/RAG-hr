# ─────────────────────────────────────────────────────────────
# Сценарий 1 (по умолчанию): локальный Ollama на хосте
# Требуется: установленный Ollama + модели
#   ollama pull bge-m3          # эмбеддинги (1024)
#   ollama pull qwen2.5:1.5b    # чат; для качества взять модель крупнее
# Запуск: docker compose up -d
# ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_BACKEND_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=bge-m3

# ─────────────────────────────────────────────────────────────
# Сценарий 2: Ollama в Docker (CPU-only, для CI/изолированных сред)
# Запуск: docker compose --profile ollama-docker up -d
# Модели скачиваются при первом обращении
# ─────────────────────────────────────────────────────────────
# OLLAMA_BASE_URL=http://ollama:11434
# LLM_BACKEND_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:1.5b

# ─────────────────────────────────────────────────────────────
# Сценарий 3: vLLM (нужна NVIDIA GPU compute ≥ 7.0, ≥ 8GB VRAM)
# Запуск: docker compose --profile vllm up -d
# Эмбеддинги всё равно считает Ollama (bge-m3): vLLM их не отдаёт
# ─────────────────────────────────────────────────────────────
# LLM_BACKEND_URL=http://vllm:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ─────────────────────────────────────────────────────────────
# Прочее (обычно менять не нужно — прокидывается из compose)
# ─────────────────────────────────────────────────────────────
# RESUMES_DIR=/app/resumes
# REDIS_URL=redis://redis:6379/0
# QDRANT_HOST=qdrant
# QDRANT_GRPC_PORT=6334
# QDRANT_COLLECTION=resumes
# LLM_API_KEY=not-needed
